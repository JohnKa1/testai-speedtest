# Proxy serverless para MobileAPI.dev
VITE_DEVICE_API_PROXY_URL=/api/device-specs

# Chave da MobileAPI.dev (opcional; mantenha vazia em commits públicos, Camadas 2 e 3 funcionam sem chave)
MOBILEAPI_KEY=

# Origem autorizada para CORS de /api/device-specs em produção (ex.: https://seu-dominio.vercel.app)
ALLOWED_ORIGIN=
