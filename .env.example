# Porta HTTP exposta no host pelo Nginx (padrao: 8080)
TESTAI_PORT=8080

# Identidade white-label do provedor (ISP) e nome do ponto de medicao
ISP_NAME=TestAi
SERVER_LABEL=On-Net Server

# Modo de medicao: "commercial" (P90 / NAT Boost) ou "sustained" (media sustentada)
MEASUREMENT_MODE=commercial

# Quantidade de fluxos paralelos concorrentes (limite seguro: 1 a 8)
PARALLEL_DOWNLOAD_STREAMS=6
PARALLEL_UPLOAD_STREAMS=4

# Origem CORS permitida pela API (use o dominio real em producao ou * para aberto)
ALLOWED_ORIGIN=*

# Teto maximo em bytes por requisicao de download (padrao: 100 MB)
MAX_DOWNLOAD_BYTES=104857600
