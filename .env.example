# Porta HTTP exposta no host pelo Nginx (padrao: 8080)
TESTAI_PORT=8080

# Identidade white-label do provedor (ISP) e nome do ponto de medicao
ISP_NAME=TestAi
SERVER_LABEL=On-Net Server

# Modo de medicao: "commercial" (P90 / NAT Boost) ou "sustained" (media sustentada)
MEASUREMENT_MODE=commercial

# Quantidade de fluxos paralelos concorrentes (limite seguro: 1 a 8)
PARALLEL_DOWNLOAD_STREAMS=6
PARALLEL_UPLOAD_STREAMS=4

# Origem CORS permitida pela API (use o dominio real em producao ou * para aberto)
ALLOWED_ORIGIN=*

# Origens autorizadas a incorporar o Modo Widget (?embed=1) via iframe (padrao: 'self')
# Ex.: ALLOWED_FRAME_ANCESTORS='self' https://www.seuprovedor.com.br https://central.seuprovedor.com.br
ALLOWED_FRAME_ANCESTORS='self'

# Confianca em X-Real-IP / X-Forwarded-For vindos de proxy reverso local/privado (Nginx/Caddy)
TRUST_PROXY=true

# Limites de fluxos simultaneos de transferencia (/api/down e /api/up)
MAX_STREAMS_PER_IP=8
MAX_GLOBAL_STREAMS=64

# Teto maximo em bytes por requisicao de download (padrao: 100 MB)
MAX_DOWNLOAD_BYTES=104857600

# Dominio publico usado pelo overlay Caddy para HTTPS automatico (Let's Encrypt)
DOMAIN=velocidade.seuprovedor.com.br

# Exposicao Prometheus (/metrics) no backend Node.js
METRICS_ENABLED=true
# Opcional: token Bearer para proteger GET /metrics (recomendado em producao)
METRICS_TOKEN=
